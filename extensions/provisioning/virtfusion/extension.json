{
    "id": "virtfusion",
    "name": "VirtFusion",
    "version": "1.0.0",
    "description": "Experimental VirtFusion provider adapter. Not available for production use.",
    "production_ready": false,
    "author": "Agovena",
    "category": "provisioning",
    "agovena": "^0.0.1",
    "provider": "Agovena\\Extensions\\Virtfusion\\VirtfusionServiceProvider",
    "dependencies": [],
    "module_dependencies": [
        "provisioning"
    ],
    "settings": [
        {
            "key": "api_url",
            "label": "virtfusion::messages.settings.api_url",
            "type": "string",
            "secret": false,
            "required": true,
            "default": "",
            "help": "virtfusion::messages.settings.api_url_help"
        },
        {
            "key": "api_token",
            "label": "virtfusion::messages.settings.api_token",
            "type": "string",
            "secret": true,
            "required": true,
            "default": "",
            "help": "virtfusion::messages.settings.api_token_help"
        },
        {
            "key": "verify_tls",
            "label": "virtfusion::messages.settings.verify_tls",
            "type": "boolean",
            "secret": false,
            "required": false,
            "default": true,
            "help": "virtfusion::messages.settings.verify_tls_help"
        },
        {
            "key": "timeout",
            "label": "virtfusion::messages.settings.timeout",
            "type": "string",
            "secret": false,
            "required": false,
            "default": "20",
            "help": "virtfusion::messages.settings.timeout_help"
        }
    ]
}
