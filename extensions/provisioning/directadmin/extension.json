{
    "id": "directadmin",
    "name": "DirectAdmin",
    "version": "1.0.0",
    "description": "First-party Agovena provisioning extension for DirectAdmin.",
    "author": "Agovena",
    "category": "provisioning",
    "agovena": "^0.0.1",
    "provider": "Agovena\\Extensions\\DirectAdmin\\DirectAdminServiceProvider",
    "dependencies": [],
    "module_dependencies": [
        "provisioning"
    ],
    "settings": [
        {
            "key": "api_url",
            "label": "directadmin::messages.settings.api_url",
            "type": "string",
            "secret": false,
            "required": true,
            "default": "",
            "help": "directadmin::messages.settings.api_url_help"
        },
        {
            "key": "api_token",
            "label": "directadmin::messages.settings.api_token",
            "type": "string",
            "secret": true,
            "required": true,
            "default": "",
            "help": "directadmin::messages.settings.api_token_help"
        },
        {
            "key": "api_username",
            "label": "directadmin::messages.settings.api_username",
            "type": "string",
            "secret": false,
            "required": true,
            "default": "",
            "help": "directadmin::messages.settings.api_username_help"
        },
        {
            "key": "verify_tls",
            "label": "directadmin::messages.settings.verify_tls",
            "type": "boolean",
            "secret": false,
            "required": false,
            "default": true,
            "help": "directadmin::messages.settings.verify_tls_help"
        },
        {
            "key": "timeout",
            "label": "directadmin::messages.settings.timeout",
            "type": "string",
            "secret": false,
            "required": false,
            "default": "20",
            "help": "directadmin::messages.settings.timeout_help"
        }
    ]
}
