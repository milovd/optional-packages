{
    "id": "enhance",
    "name": "Enhance",
    "version": "1.0.0",
    "description": "First-party Agovena provisioning extension for Enhance.",
    "author": "Agovena",
    "category": "provisioning",
    "agovena": "^0.0.1",
    "provider": "Agovena\\Extensions\\Enhance\\EnhanceServiceProvider",
    "dependencies": [],
    "module_dependencies": [
        "provisioning"
    ],
    "settings": [
        {
            "key": "api_url",
            "label": "enhance::messages.settings.api_url",
            "type": "string",
            "secret": false,
            "required": true,
            "default": "",
            "help": "enhance::messages.settings.api_url_help"
        },
        {
            "key": "api_token",
            "label": "enhance::messages.settings.api_token",
            "type": "string",
            "secret": true,
            "required": true,
            "default": "",
            "help": "enhance::messages.settings.api_token_help"
        },
        {
            "key": "account_id",
            "label": "enhance::messages.settings.account_id",
            "type": "string",
            "secret": false,
            "required": true,
            "default": "",
            "help": "enhance::messages.settings.account_id_help"
        },
        {
            "key": "verify_tls",
            "label": "enhance::messages.settings.verify_tls",
            "type": "boolean",
            "secret": false,
            "required": false,
            "default": true,
            "help": "enhance::messages.settings.verify_tls_help"
        },
        {
            "key": "timeout",
            "label": "enhance::messages.settings.timeout",
            "type": "string",
            "secret": false,
            "required": false,
            "default": "20",
            "help": "enhance::messages.settings.timeout_help"
        }
    ]
}
