{
    "id": "paddle",
    "name": "Paddle",
    "version": "1.0.0",
    "description": "First-party Paddle Billing gateway for hosted checkout, signed webhooks, and refunds.",
    "author": "Agovena",
    "category": "payment_gateway",
    "production_ready": true,
    "agovena": "^0.0.1",
    "provider": "Agovena\\Extensions\\Paddle\\PaddleServiceProvider",
    "dependencies": [],
    "settings": [
        {
            "key": "api_key",
            "label": "paddle::messages.settings.api_key",
            "type": "string",
            "secret": true,
            "required": true,
            "connection": true,
            "default": "",
            "help": "paddle::messages.settings.api_key_help"
        },
        {
            "key": "client_token",
            "label": "paddle::messages.settings.client_token",
            "type": "string",
            "secret": false,
            "required": true,
            "connection_context": true,
            "default": "",
            "help": "paddle::messages.settings.client_token_help"
        },
        {
            "key": "webhook_secret",
            "label": "paddle::messages.settings.webhook_secret",
            "type": "string",
            "secret": true,
            "required": true,
            "connection": false,
            "default": "",
            "help": "paddle::messages.settings.webhook_secret_help"
        },
        {
            "key": "sandbox",
            "label": "paddle::messages.settings.sandbox",
            "type": "boolean",
            "secret": false,
            "required": true,
            "connection_context": true,
            "default": true,
            "help": "paddle::messages.settings.sandbox_help"
        },
        {
            "key": "enabled_methods",
            "label": "paddle::messages.settings.enabled_methods",
            "type": "payment_methods",
            "secret": false,
            "required": false,
            "default": "",
            "help": "paddle::messages.settings.enabled_methods_help"
        }
    ]
}
